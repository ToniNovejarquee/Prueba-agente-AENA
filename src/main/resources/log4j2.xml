<?xml version="1.0" encoding="utf-8"?>
<!--
  Logging de poc-aena-vuelos.
  - Categoría "poc.traza": eventos de log estructurado (una línea JSON por evento, con dominio y segmento).
    El umbral real lo controla poc.logging.nivel en config/poc-global.yaml, por eso aquí se deja en DEBUG.
  - Para depurar los protocolos:
      * HttpMessageLogger en DEBUG: tráfico HTTP/A2A/MCP/LLM en crudo.
      * com.mulesoft.connectors.inference en DEBUG: prompt completo enviado al LLM y su respuesta.
-->
<Configuration>
    <Appenders>
        <RollingFile name="file" fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}poc-aena-vuelos.log"
                 filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}poc-aena-vuelos-%i.log">
            <PatternLayout charset="UTF-8" pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Log estructurado de la POC -->
        <AsyncLogger name="poc" level="DEBUG"/>

        <!-- Tráfico HTTP en crudo (descomentar SOLO para depurar en local): vuelca las cabeceras tal cual,
             incluida la API key (X-API-Key), porque no pasa por el enmascarado de poc-log. No activarlo en CloudHub. -->
        <!--AsyncLogger name="org.mule.service.http.impl.service.HttpMessageLogger" level="DEBUG"/-->
        <AsyncLogger name="org.mule.service.http" level="WARN"/>
        <AsyncLogger name="org.mule.extension.http" level="WARN"/>

        <AsyncLogger name="com.mulesoft.connectors.a2a" level="INFO"/>
        <!-- Al arrancar, el test de conectividad de los clientes A2A se ejecuta antes de que los agentes de esta misma
             app publiquen su Agent Card: Mule continúa el despliegue y el cliente conecta en la primera petición.
             Se silencian estos dos loggers para no ensuciar el arranque con un ERROR falso; un fallo real en ejecución
             llega al flujo como A2A:CONNECTIVITY y lo registra poc-log-error. -->
        <AsyncLogger name="com.mulesoft.connectors.a2a.internal.client.helper.AgentCardHelper" level="OFF"/>
        <AsyncLogger name="com.mulesoft.connectors.a2a.internal.client.connection.provider.ClientConnectionProvider" level="OFF"/>
        <AsyncLogger name="com.mulesoft.connectors.mcp" level="INFO"/>
        <AsyncLogger name="com.mulesoft.connectors.inference" level="INFO"/>

        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="INFO"/>
        <AsyncLogger name="org.mule.service.http.netty.impl.server.util.DefaultRequestMatcherRegistry" level="INFO"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
